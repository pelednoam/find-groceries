# Fetched corpus and derived data — 1.6GB of Reddit dumps plus extraction
# output. Regenerable from scripts/; never belongs in version control.
data/

# Local environment
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml

# Credentials — nothing here should ever be committed, but be explicit.
.env
*.pem
credentials

# Vendored multi-model review agent (installed from its own repo)
scripts/preflight/
scripts/review_loop/
scripts/review_*.py
scripts/scrub_diff.py
scripts/validate_review_results.py
docs/ensemble_review_result_schema.json
.claude/

# Node toolchain for the site (TypeScript + jsdom). Regenerable.
node_modules/

# Google Local slice — regenerable via scripts/fetch_google_local.py

# Google review claims — regenerable, and the raw text must not be published
data/extraction/reviews_*
